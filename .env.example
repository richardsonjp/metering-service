# =======================
# SYSTEM
# =======================
SYSTEM_APP_NAME=metering-service
# HTTP listen address.
SERVER_ADDR=:8080
# IANA timezone for log timestamps (e.g. UTC, Asia/Jakarta).
SYSTEM_TIME_ZONE=Asia/Jakarta

# =======================
# METERING
# =======================
# Global cap on metered API requests before access is stopped (<=0 = unlimited).
REQUEST_LIMIT=1000
# Global storage cap in bytes before uploads are rejected (default 1 GiB).
STORAGE_LIMIT_BYTES=1073741824
# Per-file upload cap in bytes (default 1 GiB).
MAX_UPLOAD_BYTES=1073741824

# =======================
# LOGGING
# =======================
# Log level: debug | info | warn | error.
LOG_LEVEL=info
